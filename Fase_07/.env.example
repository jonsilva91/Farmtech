# ============================================
# Configuração FarmTech - Fase 07
# ============================================
# Copie este arquivo para .env e preencha os valores

# ============================================
# AWS Configuração
# ============================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=abc123...
AWS_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:farmtech-alerts

# ============================================
# Banco de Dados
# ============================================
# Tipo: sqlite ou postgres
DB_TYPE=sqlite

# Para PostgreSQL (local ou RDS)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=farmtech
DB_USER=farmtech_user
DB_PASSWORD=farmtech_password

# ============================================
# Thresholds de Alertas
# ============================================
ALERT_UMIDADE_MIN=40.0
ALERT_UMIDADE_MAX=80.0
ALERT_PH_MIN=5.5
ALERT_PH_MAX=7.5
ALERT_FOSFORO_MIN=20.0
ALERT_POTASSIO_MIN=150.0
ALERT_TEMPERATURA_MAX=35.0

# ============================================
# API Configuração
# ============================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=2
LOG_LEVEL=INFO
